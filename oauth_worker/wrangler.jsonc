{
  "name": "osu-gacha-auth",
  "main": "src/worker.js",
  "compatibility_date": "2026-09-14",
  "workers_dev": true,
  "keep_vars": true,
  "observability": {
    "enabled": false
  },
  "vars": {
    "PUBLIC_ORIGIN": "https://osu-gacha-auth.therealdimedrol.workers.dev"
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "GACHA_AUTH",
        "class_name": "GachaAuth"
      }
    ]
  },
  "migrations": [
    {
      "tag": "gacha-desktop-v1",
      "new_sqlite_classes": [
        "GachaAuth"
      ]
    }
  ],
  "preview_urls": false
}
